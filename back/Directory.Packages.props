<Project>
  <!--
    Gestión centralizada de versiones de paquetes NuGet.
    Los proyectos declaran <PackageReference Include="..." /> sin versión; la versión se fija aquí, una sola vez.
    Los paquetes de Microsoft van alineados con el runtime de .NET 10 (mismo número de parche).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <MicrosoftVersion>10.0.13</MicrosoftVersion>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Persistencia">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(MicrosoftVersion)" />
  </ItemGroup>

  <ItemGroup Label="Identidad y seguridad">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="$(MicrosoftVersion)" />
  </ItemGroup>

  <ItemGroup Label="Infraestructura común">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftVersion)" />
  </ItemGroup>

  <ItemGroup Label="Excel">
    <!-- D42: importar establecimientos y, más adelante, exportar a Excel. Licencia MIT. -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup Label="Documentación de la API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.2" />
  </ItemGroup>

  <ItemGroup Label="Pruebas">
    <!-- xUnit v3 4.x usa Microsoft Testing Platform; global.json lo activa para "dotnet test". -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(MicrosoftVersion)" />
  </ItemGroup>

  <ItemGroup Label="Correcciones de seguridad (dependencias indirectas)">
    <!-- GHSA-846f-f764-76mx y GHSA-2fmv-rv2c-59x7: llega 9.0.11 por dependencia indirecta; se fija la versión corregida. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(MicrosoftVersion)" />
  </ItemGroup>
</Project>
