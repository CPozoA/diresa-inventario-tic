<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Punto de entrada HTTP: recibe, delega en Application y responde. Sin lógica de negocio. -->
  <PropertyGroup>
    <RootNamespace>Inventario.Api</RootNamespace>
    <UserSecretsId>inventario-tic-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- Solo para la herramienta dotnet-ef (migraciones). No se publica con la aplicación. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inventario.Application\Inventario.Application.csproj" />
    <ProjectReference Include="..\Inventario.Infrastructure\Inventario.Infrastructure.csproj" />
  </ItemGroup>

</Project>
