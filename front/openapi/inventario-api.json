    "/api/establecimientos": {
      "get": {
        "tags": [
          "Establecimientos"
        ],
        "summary": "Establecimientos ordenados por nombre. ?buscar= código único, Id_Establecimiento o parte del nombre.",
        "operationId": "ListarEstablecimientos",
        "parameters": [
          {
            "name": "sedeId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "buscar",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "incluirInactivos",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "maximo",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EstablecimientoDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
